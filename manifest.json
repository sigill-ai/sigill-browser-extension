{
  "manifest_version": 3,
  "name": "Sigill — AI Conversation Timestamper",
  "version": "0.5.0",
  "version_name": "0.5.0-dev",
  "minimum_chrome_version": "111",
  "description": "Cryptographically timestamps every AI conversation turn using RFC 3161 via Sigill.",
  "permissions": ["storage", "unlimitedStorage", "alarms", "downloads"],
  "host_permissions": [
    "https://api.sigill.ai/*",
    "https://sigill.ai/*",
    "https://claude.ai/*",
    "https://chatgpt.com/*",
    "https://gemini.google.com/*"
  ],
  "background": {
    "service_worker": "background/worker.js"
  },
  "icons": {
    "16": "icons/logo-16.png",
    "32": "icons/logo-32.png",
    "48": "icons/logo-48.png",
    "128": "icons/logo-128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Sigill Timestamper",
    "default_icon": {
      "16": "icons/logo-16.png",
      "32": "icons/logo-32.png",
      "48": "icons/logo-48.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://sigill.ai/*"],
      "js": ["content/sigill-auth.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://claude.ai/*",
        "https://chatgpt.com/*",
        "https://gemini.google.com/*"
      ],
      "js": ["content/interceptor.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://claude.ai/*",
        "https://chatgpt.com/*",
        "https://gemini.google.com/*"
      ],
      "js": ["content/relay.js"],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://claude.ai/*",
        "https://chatgpt.com/*",
        "https://gemini.google.com/*"
      ],
      "js": ["content/shared.js", "content/debug-overlay.js"],
      "run_at": "document_idle"
    }
  ]
}
