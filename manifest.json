{
  "manifest_version": 3,
  "name": "Sigill — AI Conversation Timestamper",
  "version": "0.1.0",
  "description": "Cryptographically timestamps every AI conversation turn using RFC 3161 via Sigill.",
  "permissions": ["storage", "unlimitedStorage"],
  "host_permissions": [
    "https://api.sigill.ai/*",
    "https://sigill.ai/*",
    "https://claude.ai/*",
    "https://chatgpt.com/*",
    "https://gemini.google.com/*"
  ],
  "background": {
    "service_worker": "background/worker.js"
  },
  "icons": {
    "16": "icons/logo-16.png",
    "32": "icons/logo-32.png",
    "48": "icons/logo-48.png",
    "128": "icons/logo-128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Sigill Timestamper",
    "default_icon": {
      "16": "icons/logo-16.png",
      "32": "icons/logo-32.png",
      "48": "icons/logo-48.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://sigill.ai/*"],
      "js": ["content/sigill-auth.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://claude.ai/*"],
      "js": ["content/shared.js", "content/claude.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://chatgpt.com/*"],
      "js": ["content/shared.js", "content/chatgpt.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://gemini.google.com/*"],
      "js": ["content/shared.js", "content/gemini.js"],
      "run_at": "document_idle"
    }
  ]
}
